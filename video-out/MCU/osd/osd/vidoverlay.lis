00008a 91e9      	LD	 ZL,Y+
00008b 90c4      	LPM	 R12,Z
00008c 91e9      	LD	 ZL,Y+
00008d 90d4      	LPM	 R13,Z
00008e 91e9      	LD	 ZL,Y+
00008f 90e4      	LPM	 R14,Z
000090 91e9      	LD	 ZL,Y+
