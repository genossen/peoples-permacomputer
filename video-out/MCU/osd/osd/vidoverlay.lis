0000cf   +  	SHIFTREG2VID R16
         
0000e1 2d01      	MOV  R16,R1
0000e2   +  	SHIFTREG2VID R16
         
0000f4 2d02      	MOV  R16,R2
0000f5   +  	SHIFTREG2VID R16
         
