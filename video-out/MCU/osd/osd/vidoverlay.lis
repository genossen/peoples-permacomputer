          .def	ZH	=r31
         
          .equ 	RAMEND =$45F
         
          .equ 	BOOTSTART	=$1E00  ;OBSOLETE!!! temporarily kept for compatibility
         ;.equ 	LARGEBOOTSTART	=$0C00  ;largest boot block is 2KB
         ;.equ 	SMALLBOOTSTART	=$0F80  ;smallest boot block is 256B
          .equ 	SMALLBOOTSTART	=0b1111110000000  ;($1F80) smallest boot block is 256B
          .equ 	SECONDBOOTSTART	=0b1111100000000  ;($1F00) second boot block size is 512B
          .equ 	THIRDBOOTSTART	=0b1111000000000  ;($1E00) third boot block size is 1KB
          .equ 	LARGEBOOTSTART	=0b1110000000000  ;($1C00) largest boot block is 2KB
          .equ	PAGESIZE	=64     ;number of WORDS in a page
          .equ 	FLASHEND	=$1fff
         
          .equ	INT0addr=$002	;External Interrupt0 Vector Address
          .equ	INT1addr=$004	;External Interrupt1 Vector Address
          .equ	OC2addr =$006	;Output Compare2 Interrupt Vector Address
          .equ	OVF2addr=$008	;Overflow2 Interrupt Vector Address
          .equ	ICP1addr=$00A	;Input Capture1 Interrupt Vector Address
          .equ	OC1Aaddr=$00C	;Output Compare1A Interrupt Vector Address
          .equ	OC1Baddr=$00E	;Output Compare1B Interrupt Vector Address
          .equ	OVF1addr=$010	;Overflow1 Interrupt Vector Address
          .equ	OVF0addr=$012	;Overflow0 Interrupt Vector Address
          .equ	SPIaddr =$014	;SPI Interrupt Vector Address
          .equ	URXCaddr=$016	;UART Receive Complete Interrupt Vector Address
          .equ	UDREaddr=$018	;UART Data Register Empty Interrupt Vector Address
          .equ	UTXCaddr=$01A	;UART Transmit Complete Interrupt Vector Address
          .equ	ADCCaddr=$01C	;ADC Interrupt Vector Address
          .equ	ERDYaddr=$01E	;EEPROM Interrupt Vector Address
          .equ	ACIaddr =$020	;Analog Comparator Interrupt Vector Address
          .equ    TWIaddr =$022   ;Irq. vector address for Two-Wire Interface
          .equ	INT2addr=$024   ;External Interrupt2 Vector Address
          .equ	OC0addr =$026   ;Output Compare0 Interrupt Vector Address
          .equ	SPMRaddr=$028   ;Store Program Memory Ready Interrupt Vector Address
         
          .equ	VIDPORT 		= PORTB
          .equ	SYNCPORT		= PORTC
          .equ    VIDDDR			= DDRB
          .equ	SYNCDDR			= DDRC
          .equ	VIDPIN			= PB7
          .equ	SYNCPIN			= PC7
          .equ	lineTime		= 509
          .equ	NORM_SYNC_LINE	= 1
          .equ	VSYNC_LINE		= 243
          .equ	FIELD_LINE		= 263
          .equ	SYNCON			= 0
          .equ 	SYNCOFF			= 1
          .equ    NORMSYNC		= 0x02
          .equ	INVSYNC			= 0x01
         
          .MACRO SHIFTREG2VID		; Shift 6 bits of register out to port
          	OUT VIDPORT,@0		; Bit 7
          	LSL @0
          	NOP
          	OUT VIDPORT,@0		; Bit 6
          	LSL @0
          	NOP
          	OUT VIDPORT,@0		; Bit 5
          	LSL @0
          	NOP
          	OUT VIDPORT,@0		; Bit 4
          	LSL @0
          	NOP
          	OUT VIDPORT,@0		; Bit 3
          	LSL @0
          	NOP
          	OUT VIDPORT,@0		; Bit 2
          	LSL @0
          	NOP
          .ENDMACRO
         
          .dseg
          	.org 	0x60
000060      RAMBUF:		.byte	1000
000448      RAMPTR:		.byte	2
00044a      CURSOR:		.byte	2
00044c      TMP_YL:		.byte	1
00044d      TMP_YH:		.byte	1
00044e      TMP_ZL:		.byte	1
00044f      LINE:		.byte   1
000450      LINEH:		.byte   1
000451      SYNCPOL: 	.byte	1
         
          .cseg
          	.org 0
000000 940c 002a 	JMP	RESET	;RESET vector
000002 940c 032a 	JMP	HSYNC1	;IRQ0 vector
000004 940c 0378 	JMP	VSYNC	;IRQ1 vector
000006 940c 002a 	JMP	RESET	;T2 COMPARE vector
000008 940c 002a 	JMP	RESET	;T2 OVF vector
00000a 940c 002a 	JMP	RESET	;T1 CAPTURE vector
00000c 940c 0334 	JMP	HSYNC2	;T1 COMPARE A vector
00000e 940c 002a 	JMP	RESET	;T1 COMPARE B vector
000010 940c 002a 	JMP	RESET	;T1 OVF vector
000012 940c 002a 	JMP	RESET	;T0 OVF vector
000014 940c 002a 	JMP	RESET	;SERIAL XFER COMPLETE vector
000016 940c 002a 	JMP	RESET	;USART RX vector
000018 940c 002a 	JMP	RESET	;USART DREG EMPTY vector
00001a 940c 002a 	JMP	RESET	;USART TX vector
00001c 940c 002a 	JMP	RESET	;ADC vector
00001e 940c 002a 	JMP	RESET	;EEPROM vector
000020 940c 002a 	JMP	RESET	;COMPARATOR vector
000022 940c 002a 	JMP	RESET	;2-WIRE vector
000024 940c 002a 	JMP	RESET	;IRQ2 vector
000026 940c 002a 	JMP	RESET	;T0 COMPARE vector
000028 940c 002a 	JMP	RESET	;SPM READY vector
         
          RESET:
00002a e004      	LDI	R16,HIGH(RAMEND)	; Init SP
00002b bf0e      	OUT	SPH,R16
00002c e50f      	LDI	R16,LOW(RAMEND)
00002d bf0d      	OUT	SPL,R16
         	
         ;	LDI R16, 0xA7
         ;	OUT OSCCAL, R16
         
00002e e003       	LDI R16, 0x03 					;One NTSC line 509
00002f bd0b      	OUT OCR1AH, R16
000030 ef0a      	LDI R16, 0xFA
000031 bd0a      	OUT OCR1AL, R16
         
000032 e009        	LDI R16,(1 << WGM12)|(1 << CS10)	;full speed; clear-on-match
000033 bd0e       	OUT TCCR1B, R16
000034 e000          LDI R16, 0x00						;turn off pwm and oc lines
000035 bd0f        	OUT TCCR1A, R16
000036 e100        	LDI R16, (1 << OCIE1A)				;enable interrupt T1A compare
000037 bf09        	OUT TIMSK, R16
000038 e800      	LDI R16, (1<<VIDPIN)
000039 bb07         	OUT VIDDDR, R16
00003a e800      	LDI R16, (1<<SYNCPIN)
00003b bb04      	OUT SYNCDDR, R16
00003c e002      	LDI	R16, NORMSYNC
00003d 9300 0451 	STS	SYNCPOL, R16
         
00003f e001      	LDI	R16,1				; Line = 1
000040 9300 044f 	STS	LINE,R16
000042 e000      	LDI	R16, 0x00
000043 9300 0450 	STS	LINEH,R16
         
000045 ec00      	LDI	R16,(1 << INT0) | (1 << INT1)
000046 bf0b      	OUT	GICR,R16
         
000047 2700      	CLR R16
000048 bd00      	OUT UBRRH,R16
000049 e607      	LDI R16, 103				; 9600 baud
00004a b909      	OUT UBRRL,R16
00004b e108      	LDI R16,(1 << RXEN) | (1 << TXEN)
00004c b90a      	OUT UCSRB,R16
00004d e806      	LDI R16,(1 << URSEL) | (1 << UCSZ1) | (1 << UCSZ0)	; 8N1
00004e bd00      	OUT UCSRC,R16
         
         
00004f e0d0      	LDI	YH,HIGH(RAMBUF)
000050 93d0 0448 	STS	RAMPTR,YH
000052 e6c0      	LDI	YL,LOW(RAMBUF)
000053 93c0 0449 	STS	RAMPTR+1,YL
         
000055 e40a      	LDI	R16,(1 << SE) | (1 << ISC11) | (1 << ISC01)
000056 bf05      	OUT	MCUCR,R16			; Enable sleep and interrupt on rising edge of ext int
         	
000057 940e 031b 	CALL CLRS
000059 9478      	SEI
         	
          MAIN:
00005a 9588      	SLEEP					; Wait for sync
         
00005b 9100 044f 	LDS	 R16,LINE			; Read line counter
00005d 3208      	CPI	 R16,40 			; Ignore first 40 lines
00005e f3d8      	BRCS MAIN
00005f 3c08      	CPI	 R16,200			; And everything beyond line 200
000060 f7c8      	BRCC MAIN
         
000061 2711      	CLR	 R17
000062 e2f0      	LDI	 ZH,HIGH(CHRTAB*2)	; ZH = Table offset
000063 2fe0      	MOV	 ZL,R16				; + line number
000064 70e7      	ANDI ZL,7
000065 0ffe      	ADD	 ZH,ZL
         
000066 5208      	SUBI R16,$28
000067 e0d0      	LDI	 YH,HIGH(RAMBUF)	; Point to current character line in RAM
000068 e6c0      	LDI	 YL,LOW(RAMBUF)
000069 7f08      	ANDI R16,0xF8
00006a 0f00      	LSL	 R16				; Add line offset (line*32)
00006b 1f11      	ROL	 R17
00006c 0f00      	LSL	 R16
00006d 1f11      	ROL	 R17
00006e 0fc0      	ADD	 YL,R16
00006f 1fd1      	ADC	 YH,R17
         
000070 91e9      	LD	 ZL,Y+
000071 9104      	LPM	 R16,Z
000072 91e9      	LD	 ZL,Y+				; Read next character from RAM buffer into LSB
000073 9004      	LPM	 R0,Z				; Look it up
000074 91e9      	LD	 ZL,Y+				; Fill all 32 registers
000075 9014      	LPM	 R1,Z
000076 91e9      	LD	 ZL,Y+
000077 9024      	LPM	 R2,Z
000078 91e9      	LD	 ZL,Y+
