000380 e6a0      	LDI	 XL,LOW(RAMBUF)
000381 93a0 0449 	STS	 RAMPTR+1,XL
000383 91df      	POP YH
000384 91cf      	POP YL
000385 91bf      	POP XH
000386 91af      	POP XL
