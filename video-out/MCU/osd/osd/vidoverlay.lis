00009d 9164      	LPM	 R22,Z
00009e 91e9      	LD	 ZL,Y+
00009f 9174      	LPM	 R23,Z
0000a0 91e9      	LD	 ZL,Y+
0000a1 9184      	LPM	 R24,Z
0000a2 91e9      	LD	 ZL,Y+
0000a3 9194      	LPM	 R25,Z
0000a4 91e9      	LD	 ZL,Y+
0000a5 91a4      	LPM	 R26,Z
0000a6 91e9      	LD	 ZL,Y+
0000a7 91b4      	LPM	 R27,Z
0000a8 91e9      	LD	 ZL,Y+				; Want to preserve YH & YL for now
0000a9 91e4      	LPM	 ZL,Z
0000aa 93e0 044c 	STS	 TMP_YL,ZL
0000ac 91e9      	LD	 ZL,Y+
0000ad 91e4      	LPM	 ZL,Z
0000ae 93e0 044d 	STS	 TMP_YH,ZL
0000b0 91e9      	LD	 ZL,Y+
0000b1 91e4      	LPM	 ZL,Z
0000b2 93e0 044e 	STS	 TMP_ZL,ZL			; Also want to preserve ZL
0000b4 91e9      	LD	 ZL,Y+
0000b5 91f4      	LPM	 ZH,Z
0000b6 91e0 044e 	LDS	 ZL,TMP_ZL			; Load up YH, YL, and ZL
0000b8 91c0 044c 	LDS	 YL,TMP_YL
0000ba 91d0 044d 	LDS	 YH,TMP_YH	
         
         ; Start shifting out to the screen
0000bc   +  	SHIFTREG2VID R16
         
