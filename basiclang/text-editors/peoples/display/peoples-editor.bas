
REM Stefan's BASIC

REM https://github.com/slviajero/tinybasic


5 SET 22,"Apple1"

9 REM VARS
10 DIM BUFFER(40,25)
20 DIM CURSORX: DIM CURSORY
   
   REM SUBROUTINES
   REM
   REM INITIALISE BUFFER
   REM PRINT BUFFER
   REM ACCEPT INPUT
   REM EVALUATE
   REM RETURN TO PRINT BUFFER
   
100 REM INITIALISE BUFFER
110 GOSUB 1000
120 REM PRINT BUFFER
130 GOSUB 2000
140 REM USER INPUT
150 GOSUB 3000
160 REM LOOP
170 GOTO 130
    
   
1000 FOR TEMPY=1 TO 25
1010     FOR TEMPX=1 TO 40
1020         BUFFER(TEMPX,TEMPY)=0
1030     NEXT TEMPX
1040 NEXT TEMPY
1050 LET CURSORX=1
1060 LET CURSORY=1
1070 RETURN

2000 FOR TEMPY=1 TO 25
2010     FOR TEMPX=1 TO 40
2020         PRINT CHR$(BUFFER(TEMPX,TEMPY));
2030     NEXT TEMPX
2040     PRINT
2050 NEXT TEMPY
2060 RETURN
     
3000 GET I$
3010 IF I$="" THEN GOTO 3000
3015 IF ASC(I$)=10 THEN CURSORY=CURSORY+1:GOTO 3040
3020 LET BUFFER(CURSORX,CURSORY)=ASC(I$)
3030 LET CURSORX=CURSORX+1
3040 IF CURSORX>40 THEN CURSORX=1:CURSORY=CURSORY+1
3050 IF CURSORY=25 AND CURSORX=40 THEN END
3060 RETURN
