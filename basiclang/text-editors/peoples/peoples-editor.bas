10 REM ========================================
20 REM THE PEOPLE'S TEXT EDITOR
30 REM STEFAN'S TINY BASIC EDITION
40 REM VERSION 1.0 - FOR COMPUTER LITERACY
50 REM ========================================
60 SET 22,"Apple1"
70 REM
80 REM VARIABLES:
90 REM T$() - TEXT BUFFER (255 CHARS MAX, 50 LINES)
100 REM LC   - LINE COUNT (0 MEANS EMPTY)
110 REM L$   - TEMPORARY LINE INPUT
120 REM C$   - COMMAND CHARACTER
130 REM F$   - FILE NAME FOR SAVE/LOAD
140 REM S$   - SEARCH TEXT
150 REM I,J  - LOOP COUNTERS
160 REM F    - FOUND COUNT FOR SEARCH
170 REM L    - LINE NUMBER FOR DELETE
180 REM ========================================
190 DIM T$(80,50)   : REM 255 CHARS MAX, 50 LINES
200 LC=0
210 REM ========== MAIN MENU LOOP ==========
220 PRINT "THE PEOPLE'S TEXT EDITOR 1.0"
230 PRINT "-----------------------------"
240 PRINT "A - ADD TEXT"
250 PRINT "L - LIST TEXT"
260 PRINT "D - DELETE LINE"
270 PRINT "S - SEARCH TEXT"
280 PRINT "W - WRITE TO FILE"
290 PRINT "R - READ FROM FILE"
300 PRINT "Q - QUIT"
310 PRINT "-----------------------------"
320 PRINT "COMMAND: "
330 INPUT C$
340 IF C$="A" THEN 1000
350 IF C$="L" THEN 1100
360 IF C$="D" THEN 1200
370 IF C$="S" THEN 1300
380 IF C$="W" THEN 1400
390 IF C$="R" THEN 1500
400 IF C$="Q" THEN END
410 PRINT "UNKNOWN COMMAND"
420 GOTO 320
1000 REM ========== ADD TEXT ==========
1010 PRINT "ADD TEXT (ENTER . TO STOP)"
1020 PRINT "LINE ";LC+1;": "
1030 INPUT L$
1040 IF L$="." THEN 320
1050 IF LC>=50 THEN PRINT "BUFFER FULL!": GOTO 320
1060 LC=LC+1
1070 T$()(LC)=L$
1080 GOTO 1020
1100 REM ========== LIST TEXT ==========
1110 IF LC=0 THEN PRINT "BUFFER EMPTY": GOTO 320
1120 FOR I=1 TO LC
1130 PRINT I;" ";T$()(I)
1140 NEXT I
1150 PRINT "--- ";LC;" LINES TOTAL ---"
1160 GOTO 320
1200 REM ========== DELETE LINE ==========
1210 PRINT "LINE TO DELETE: "
1220 INPUT L
1230 IF L<1 THEN PRINT "BAD LINE NUMBER": GOTO 320
1240 IF L>LC THEN PRINT "BAD LINE NUMBER": GOTO 320
1250 FOR I=L TO LC-1
1260 T$()(I)=T$()(I+1)
1270 NEXT I
1280 LC=LC-1
1290 PRINT "LINE ";L;" DELETED"
1300 GOTO 320
1300 REM ========== SEARCH TEXT ==========
1310 PRINT "SEARCH FOR: "
1320 INPUT S$
1330 IF S$="" THEN 320
1340 PRINT "SEARCHING..."
1350 F=0
1360 FOR I=1 TO LC
1370 IF INSTR(T$()(I),S$)>0 THEN PRINT I;" ";T$()(I): F=F+1
1380 NEXT I
1390 IF F=0 THEN PRINT "NOT FOUND"
1400 PRINT "FOUND ";F;" MATCHES"
1410 GOTO 320
1400 REM ========== WRITE TO FILE ==========
1410 PRINT "FILE NAME: "
1420 INPUT F$
1430 PRINT "SAVING..."
1440 @S=0
1450 OPEN F$,1
1460 FOR I=1 TO LC
1470 PRINT &16,T$()(I)
1480 NEXT I
1490 CLOSE 1
1495 PRINT "SAVED ";LC;" LINES"
1496 GOTO 320
1500 REM ========== READ FROM FILE ==========
1510 PRINT "FILE NAME: "
1520 INPUT F$
1530 PRINT "LOADING..."
1540 @S=0
1550 OPEN F$,0
1560 IF @S<>0 THEN PRINT "OPEN FAILED": GOTO 320
1570 LC=0
1580 INPUT &16,L$
1590 IF @S=-1 THEN 1640
1600 IF LC>=50 THEN PRINT "BUFFER FULL": GOTO 1640
1610 LC=LC+1
1620 T$()(LC)=L$
1630 GOTO 1580
1640 CLOSE 0
1650 PRINT "LOADED ";LC;" LINES"
1660 GOTO 320
